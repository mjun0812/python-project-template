{
  "permissions": {
    "allow": [
      "Bash(uv run --frozen *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(*.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/format-python.sh\""
          }
        ]
      }
    ]
  }
}
